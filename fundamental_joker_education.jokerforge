        ],
        "customCode": {
          "fullCode": "--  The Halls\nSMODS.Consumable {\n    key = 'the_halls',\n    set = 'class',\n    pos = {\n        x = 0,\n        y = 0\n    },\n    loc_txt = {\n        ['name'] = 'The Halls',\n        ['text'] = {\n            [1] = 'Creates a random {C:uncommon}Student{} {C:attention}Joker{}',\n            [2] = '{C:inactive}(Must have room){}'\n        }\n    },\n    cost = 5,\n    unlocked = true,\n    discovered = true,\n    atlas = 'CustomConsumables',\n    use = function(self, card, area, copier)\n        do\n            local created_joker = false\n            if G.jokers and G.jokers.cards and G.jokers.config and #G.jokers.cards + (G.GAME.joker_buffer or 0) < G.jokers.config.card_limit then\n                created_joker = true\n                G.GAME.joker_buffer = (G.GAME.joker_buffer or 0) + 1\n            G.E_MANAGER:add_event(Event({\n            func = function()\n            local joker_card = SMODS.add_card({ set = 'fpe_students' })\n                        G.GAME.joker_buffer = math.max(0, (G.GAME.joker_buffer or 1) - 1)\n            return true\n            end\n            }))\n            end\n            play_sound('timpani')\n            return {\n                message = created_joker and localize('k_plus_joker'),\n                colour = G.C.GREEN\n            }\n        end\n    end,\n    can_use = function(self, card)\n        return true\n    end\n}\n",
          "lastGeneratedCode": "--  The Halls\nSMODS.Consumable {\n    key = 'the_halls',\n    set = 'class',\n    pos = {\n        x = 0,\n        y = 0\n    },\n    loc_txt = {\n        ['name'] = 'The Halls',\n        ['text'] = {\n            [1] = 'Creates a random {C:uncommon}Student{} {C:attention}Joker{}',\n            [2] = '{C:inactive}(Must have room){}'\n        }\n    },\n    cost = 5,\n    unlocked = true,\n    discovered = true,\n    atlas = 'CustomConsumables',\n    use = function(self, card, area, copier)\n        do\n            local created_joker = false\n            if G.jokers and G.jokers.cards and G.jokers.config and #G.jokers.cards + (G.GAME.joker_buffer or 0) < G.jokers.config.card_limit then\n                created_joker = true\n                G.GAME.joker_buffer = (G.GAME.joker_buffer or 0) + 1\n            G.E_MANAGER:add_event(Event({\n            func = function()\n            local joker_card = SMODS.add_card({ set = 'fpe_students' })\n                        G.GAME.joker_buffer = math.max(0, (G.GAME.joker_buffer or 1) - 1)\n            return true\n            end\n            }))\n            end\n            play_sound('fpe_rileyStab')\n            return {\n                message = created_joker and localize('k_plus_joker'),\n                colour = G.C.GREEN\n            }\n        end\n    end,\n    can_use = function(self, card)\n        return true\n    end\n}\n",
