        "appearFlags": [],
        "info_queues": [],
        "card_dependencies": [],
        "overlayImage": "data:image/png;base64,",
        "perishable_compat": true,
        "customCode": {
          "fullCode": "--  Δlice\nSMODS.Joker {\n    key = '_lice',\n    config = {\n        extra = {\n            numerator_0 = 1,\n            odds_0 = 2,\n            aliceXMult = 1\n        }\n    },\n\n    loc_txt = {\n        ['name'] = 'Alice',\n        ['text'] = {\n            [1] = '{C:green}1 in 2{} chance to apply {C:dark_edition}Negative{} to {C:red}discarded{} {C:attention}face cards{}',\n            [2] = 'Scales {X:mult,C:white}0.5{} Mult when {C:attention}ability is activated{}',\n            [3] = '{C:inactive}(Currently{} {X:mult,C:white}#1#{} {C:inactive}Mult){}'\n        }\n    },\n    pos = {\n        x = 4,\n        y = 2\n    },\n    soul_pos = {x = 5, y = 2},\n    cost = 20,\n    rarity = 4,\n    blueprint_compat = true,\n    eternal_compat = true,\n    perishable_compat = true,\n    unlocked = true,\n    discovered = true,\n    atlas = 'CustomJokers',\n\n    loc_vars = function(self, info_queue, card)\n        local new_numerator0, new_denominator0 = SMODS.get_probability_vars(card, self.config.extra.numerator_0, self.config.extra.odds_0, 'j_fpe__lice')\n        return {\n            vars = {\n                card.ability.extra.aliceXMult,\n                new_numerator0,\n                new_denominator0\n            }\n        }\n    end,\n    calculate = function(self, card, context)\n        if context.discard then\n            if context.other_card:is_face() then\n                if SMODS.pseudorandom_probability(card, 'group0', card.ability.extra.numerator_0, card.ability.extra.odds_0, 'j_fpe__lice', false) then\n                    local target_card = card\n                    if target_card then\n                    target_card:juice_up(1, 1)\n                    end\n                    return {\n                        func = function()\n                                    context.other_card:set_edition(\"e_negative\", true)\n                                        return true\n                        end,\n                        message = 'Card Modified!',\n                        colour = G.C.BLUE,\n                        extra = {\n                            func = function()\n                                card.ability.extra.aliceXMult = (card.ability.extra.aliceXMult) + 0.5\n                                return true\n                            end,\n                            colour = G.C.GREEN\n                        }\n                    }\n                end\n            end\n        end\n        if context.joker_main then\n            do\n                return {\n                    Xmult = card.ability.extra.aliceXMult\n                }\n            end\n        end\n    end\n}",
          "lastGeneratedCode": "--  Alice\nSMODS.Joker {\n    key = 'alice',\n    config = {\n        extra = {\n            var_aliceXMult0 = 0.5,\n            numerator_0 = 1,\n            odds_0 = 2,\n            aliceXMult = 1\n        }\n    },\n    loc_txt = {\n        ['name'] = 'Alice',\n        ['text'] = {\n            [1] = '{C:green}1 in 2{} chance to apply {C:dark_edition}Negative{} to {C:red}discarded{} {C:attention}face cards{}',\n            [2] = 'Scales {X:mult,C:white}0.5{} Mult when {C:attention}ability is activated{}',\n            [3] = '{C:inactive}(Currently {}{X:mult,C:white}#1#{} {C:inactive} Mult){}'\n        }\n    },\n    pos = {\n        x = 0,\n        y = 0\n    },\n    cost = 20,\n    rarity = 4,\n    blueprint_compat = true,\n    eternal_compat = true,\n    perishable_compat = true,\n    unlocked = true,\n    discovered = true,\n    atlas = 'CustomJokers',\n    loc_vars = function(self, info_queue, card)\n        local new_numerator0, new_denominator0 = SMODS.get_probability_vars(card, self.config.extra.numerator_0, self.config.extra.odds_0, 'j_fpe_alice')\n        return {\n            vars = {\n                self.config.extra.aliceXMult,\n                self.config.extra.var_aliceXMult0,\n                new_numerator0,\n                new_denominator0\n            }\n        }\n    end,\n    calculate = function(self, card, context)\n        if context.discard then\n            if context.other_card:is_face() then\n                if SMODS.pseudorandom_probability(card, 'group0', card.ability.extra.numerator_0, card.ability.extra.odds_0, 'j_fpe_alice', false) then\n                    return {\n                        func = function()\n                            \n                                    context.other_card:set_edition(\"e_negative\", true)\n                                        return true\n                        end,\n                        message = 'Card Modified!',\n                        colour = G.C.BLUE,\n                        extra = {\n                            func = function()\n                                card.ability.extra.aliceXMult = (card.ability.extra.aliceXMult) + card.ability.extra.var_aliceXMult0\n                                return true\n                            end,\n                            colour = G.C.GREEN\n                        }\n                    }\n                end\n            end\n        end\n        if context.joker_main then\n            do\n                return {\n                    Xmult = card.ability.extra.aliceXMult\n                }\n            end\n        end\n    end\n}\n",
