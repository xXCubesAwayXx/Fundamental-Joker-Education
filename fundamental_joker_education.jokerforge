      {
        "id": "9ac94e67-6114-4bb8-b642-9fec645e5508",
        "objectType": "consumable",
        "name": "Geometry",
        "description": "{C:green}1 in 2 chance{} to apply a {C:enhanced}permanent{}[s]{C:blue}+25 Chips{} {C:attention}bonus{} to {C:attention}2 selected cards{}",
        "image": "data:image/png;base64,",
        "orderValue": 8,
        "set": "class",
        "cost": 5,
        "unlocked": true,
        "discovered": true,
        "rules": [
          {
            "id": "b932076a-bdf3-41ca-bb90-bd45378943da",
