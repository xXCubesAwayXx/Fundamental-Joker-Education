        "perishable_compat": true,
        "customCode": {
          "fullCode": "--  Miss Bloomie\nSMODS.Joker {\n    key = 'miss_bloomie',\n    loc_txt = {\n        [\"name\"] = \"Miss Bloomie\",\n        [\"text\"] = {\n            \"If discarded hand has only {C:attention}1{} card,\",\n            \"{C:red}destroys{} that card and creates {C:attention}2{} copies with\",\n            \"a random {C:enhanced}Enhancement{}, {C:attention}Seal{}, and {C:dark_edition}Edition\",\n            \"{C:inactive}Optimized by{} {C:dark_edition, E:1}baldmorning!{}\"\n        }\n    },\n    pos = { x = 9, y = 1 },\n    attributes = { \"destroy_card\", \"enhancements\", \"seals\", \"editions\" },\n    cost = 20,\n    rarity = 4,\n    blueprint_compat = true,\n    atlas = \"CustomJokers\",\n    calculate = function(self, card, context)\n        if context.discard and #context.full_hand == 1 then\n            local target_card = context.full_hand[1]\n            if target_card then\n                for i = 1, 2 do\n                    SMODS.add_card({\n                        suit = target_card.base.suit,\n                        rank = target_card.base.value,\n                        edition = SMODS.poll_edition({ guaranteed = true }),\n                        seal = SMODS.poll_seal({ guaranteed = true }),\n                        enhancement = SMODS.poll_enhancement({ guaranteed = true })\n                    })\n                end\n                return {\n                    remove = true,\n                    message = localize(\"k_copied_ex\")\n                }\n            end\n        end\n    end\n}\n",
          "lastGeneratedCode": "--  Miss Bloomie\nSMODS.Joker {\n    key = 'miss_bloomie',\n    config = {\n        extra = {\n            discarded_card_count_value0 = 1,\n            loop_count_0 = 2,\n            bloomieDiscardCopySuit = 'Spades',\n            bloomieDiscardCopyRank = '2'\n        }\n    },\n    loc_txt = {\n        ['name'] = 'Miss Bloomie',\n        ['text'] = {\n            [1] = 'When {C:red}discarded hand{} is {C:attention}1 card only{},',\n            [2] = '{C:red}destroys{} that card and creates {C:attention}2{} copies with',\n            [3] = 'a random {C:enhanced}Enhancement,{} {C:spectral}Seal,{} and {C:dark_edition}Edition{}',\n            [4] = '{C:inactive}Optimized by{} {C:dark_edition, E:1}baldmorning!{}'\n        }\n    },\n    pos = {\n        x = 0,\n        y = 0\n    },\n    cost = 20,\n    rarity = 4,\n    blueprint_compat = true,\n    eternal_compat = true,\n    perishable_compat = true,\n    unlocked = true,\n    discovered = true,\n    atlas = 'CustomJokers',\n    set_ability = function(self, card, initial)\n        if not G.GAME or not G.GAME.current_round then return end\n        G.GAME.current_round.bloomieDiscardCopySuit_card = { suit = 'Spades' }\n        G.GAME.current_round.bloomieDiscardCopyRank_card = { rank = '2', id = 2 }\n    end,\n    loc_vars = function(self, info_queue, card)\n        return {\n            vars = {\n                localize((G.GAME.current_round.bloomieDiscardCopySuit_card or {}).suit or 'Spades', 'suits_singular'),\n                localize((G.GAME.current_round.bloomieDiscardCopyRank_card or {}).rank or '2', 'ranks'),\n                self.config.extra.discarded_card_count_value0,\n                self.config.extra.loop_count_0\n            },\n            colours = {\n                G.C.SUITS[(G.GAME.current_round.bloomieDiscardCopySuit_card or {}).suit or 'Spades']\n            }\n        }\n    end,\n    calculate = function(self, card, context)\n        if context.pre_discard then\n            if #context.full_hand == card.ability.extra.discarded_card_count_value0 then\n                for i = 1, card.ability.extra.loop_count_0 do\n                    SMODS.add_card({ set = 'Base' })\n                    return {\n                        message = 'Added Card!',\n                        colour = G.C.GREEN\n                    }\n                end\n            end\n        end\n    end\n}\n",
          "segments": [
