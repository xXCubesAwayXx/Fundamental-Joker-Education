        "userVariables": [
          {
            "id": "6fc9882d-801b-4e4d-92a3-f508ac02bd2a",
            "name": "oliverMult",
            "type": "number",
            "isGlobal": false,
            "isPersistent": false,
            "initialValue": 0
          }
        ],
        "perishable_compat": true,
        "customCode": {
          "fullCode": "--  Oliver\nSMODS.Joker {\n    key = 'oliver',\n    config = {\n        extra = { oliverMult = 0 }\n    },\n    loc_txt = {\n        ['name'] = 'Oliver',\n        ['text'] = {\n            [1] = '{C:red}+10{} Mult for all cards {C:attention}in your full deck{} with an {C:dark_edition}Edition{}',\n            [2] = '{C:inactive}(Currently{} {C:red}+#1#{} {C:inactive}Mult){}'\n        }\n    },\n\n    pos = {\n        x = 5,\n        y = 1\n    },\n    cost = 9,\n    rarity = 3,\n    blueprint_compat = true,\n    eternal_compat = true,\n    perishable_compat = true,\n    unlocked = true,\n    discovered = true,\n    atlas = 'CustomJokers',\n\n    loc_vars = function(self, info_queue, card)\n        return {\n            vars = {\n                card.ability.extra.oliverMult\n            }\n        }\n    end,\n\n    calculate = function(self, card, context)\nif context.joker_main then\n    local edition_tally = 0\n    for k, v in pairs(G.playing_cards) do\n        if v.edition then\n            edition_tally = edition_tally + 1\n        end\n    end\n    return {mult = card.ability.extra.oliverMult + (edition_tally * 10)}\nend\nend\n}",
          "lastGeneratedCode": "--  Oliver\nSMODS.Joker {\n    key = 'oliver',\n    config = {\n        extra = { oliverMult = 0 }\n    },\n    loc_txt = {\n        ['name'] = 'Oliver',\n        ['text'] = {\n            [1] = '{C:red}+10{} Mult for all cards {C:attention}in your full deck{} with an {C:dark_edition}Edition{}',\n            [2] = '{C:inactive}(Currently{} {C:red}+#1#{} {C:inactive}Mult){}'\n        }\n    },\n    pos = {\n        x = 0,\n        y = 0\n    },\n    cost = 9,\n    rarity = 3,\n    blueprint_compat = true,\n    eternal_compat = true,\n    perishable_compat = true,\n    unlocked = true,\n    discovered = true,\n    atlas = 'CustomJokers',\n    loc_vars = function(self, info_queue, card)\n        return {\n            vars = {\n                self.config.extra.oliverMult\n            }\n        }\n    end,\n    calculate = function(self, card, context)\n        if context.joker_main then\n            do\n                card.ability.extra.oliverMult = (card.ability.extra.oliverMult) + foil_cards_in_deck * 10\n                return {\n                    colour = G.C.GREEN,\n                    extra = {\n                        mult = card.ability.extra.oliverMult\n                    }\n                }\n            end\n        end\n    end\n}\n",
