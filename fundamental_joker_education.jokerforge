        "card_dependencies": [],
        "perishable_compat": true,
        "customCode": {
          "fullCode": "--  Miss Grace\nSMODS.Joker {\n    key = 'miss_grace',\n    loc_txt = {\n        ['name'] = 'Miss Grace',\n        ['text'] = {\n            [1] = '{C:attention}Prevents death{} when {C:attention}score{} is over {C:attention}50% of blind requirement{}',\n            [2] = '{C:green}Does not destroy self{}'\n        }\n    },\n    pos = {\n        x = 7,\n        y = 2\n    },\n    cost = 30,\n    rarity = 4,\n    blueprint_compat = false,\n    eternal_compat = true,\n    perishable_compat = true,\n    unlocked = true,\n    discovered = true,\n    atlas = 'CustomJokers',\n    calculate = function(self, card, context)\n        if context.end_of_round and context.game_over and context.main_eval and not context.blueprint then\n            if ((G.GAME.chips or 0) / (G.GAME.blind.chips or 1) * 100) >= 50 then\n                return {\n                    saved = true,\n                    message = localize('k_saved_ex'),\n                    colour = G.C.RED\n                }\n            end\n        end\n    end\n}\n",
          "lastGeneratedCode": "--  Miss Grace\nSMODS.Joker {\n    key = 'miss_grace',\n    config = {\n        extra = { blind_req_percentage0 = 50 }\n    },\n    loc_txt = {\n        ['name'] = 'Miss Grace',\n        ['text'] = {\n            [1] = '{C:attention}Prevents death{} when {C:attention}score{} is over {C:attention}50% of blind requirement{}',\n            [2] = '{C:green}Does not destroy self{}'\n        }\n    },\n    pos = {\n        x = 0,\n        y = 0\n    },\n    cost = 30,\n    rarity = 4,\n    blueprint_compat = false,\n    eternal_compat = true,\n    perishable_compat = true,\n    unlocked = true,\n    discovered = true,\n    atlas = 'CustomJokers',\n    loc_vars = function(self, info_queue, card)\n        return {\n            vars = {\n                self.config.extra.blind_req_percentage0\n            }\n        }\n    end,\n    calculate = function(self, card, context)\n        if context.end_of_round and context.game_over and context.main_eval and not context.blueprint then\n            if ((G.GAME.chips or 0) / (G.GAME.blind.chips or 1) * 100) >= card.ability.extra.blind_req_percentage0 then\n                return {\n                    saved = true,\n                    message = localize('k_saved_ex'),\n                    colour = G.C.RED\n                }\n            end\n        end\n    end\n}\n",
