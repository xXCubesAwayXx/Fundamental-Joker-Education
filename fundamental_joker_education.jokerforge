        "perishable_compat": true,
        "customCode": {
          "fullCode": "--  Skell\nSMODS.Joker {\n    key = 'skell',\n    config = {\n        extra = {\n            Xmult0 = 1.5,\n        }\n    },\n    loc_txt = {\n        ['name'] = 'Skell',\n        ['text'] = {\n            [1] = '{X:mult,C:white}1.5{} Mult on {C:attention}first hand of round{}'\n        }\n    },\n    pos = {\n        x = 1,\n        y = 1\n    },\n    cost = 6,\n    rarity = 2,\n    blueprint_compat = true,\n    eternal_compat = true,\n    perishable_compat = true,\n    unlocked = true,\n    discovered = true,\n    atlas = 'CustomJokers',\n    loc_vars = function(self, info_queue, card)\n        return {\n            vars = {\n                self.config.extra.Xmult0,\n            }\n        }\n    end,\n    calculate = function(self, card, context)\n        if context.joker_main then\n            if G.GAME.current_round.hands_played == 0 then\n                return {\n                    Xmult = card.ability.extra.Xmult0\n                }\n            end\n        end\n    end\n}",
          "lastGeneratedCode": "--  Skell\nSMODS.Joker {\n    key = 'skell',\n    config = {\n        extra = {\n            Xmult0 = 1.5,\n            juice_scale0 = 1,\n            juice_rotation0 = 1\n        }\n    },\n    loc_txt = {\n        ['name'] = 'Skell',\n        ['text'] = {\n            [1] = '{X:mult,C:white}1.5{} Mult on {C:attention}first hand of round{}'\n        }\n    },\n    pos = {\n        x = 0,\n        y = 0\n    },\n    cost = 6,\n    rarity = 2,\n    blueprint_compat = true,\n    eternal_compat = true,\n    perishable_compat = true,\n    unlocked = true,\n    discovered = true,\n    atlas = 'CustomJokers',\n    loc_vars = function(self, info_queue, card)\n        return {\n            vars = {\n                self.config.extra.Xmult0,\n                self.config.extra.juice_scale0,\n                self.config.extra.juice_rotation0\n            }\n        }\n    end,\n    calculate = function(self, card, context)\n        if context.joker_main then\n            if G.GAME.current_round.hands_played == 0 then\n                return {\n                    Xmult = card.ability.extra.Xmult0\n                }\n            end\n        end\n        if context.first_hand_drawn then\n            do\n                local target_card = card\n                if target_card then\n                local function juice_card_until_(juice_target, eval_func, first, delay)\n                G.E_MANAGER:add_event(Event({\n                trigger = 'after',\n                delay = delay or 0.1,\n                blocking = false,\n                blockable = false,\n                timer = 'REAL',\n                func = (function()\n                if eval_func(juice_target) then\n                if not first or first then\n                juice_target:juice_up(card.ability.extra.juice_scale0, card.ability.extra.juice_rotation0)\n                end\n                juice_card_until_(juice_target, eval_func, nil, 0.8)\n                end\n                return true\n                end)\n                }))\n                end\n                local eval = function() return not G.RESET_JIGGLES end\n                juice_card_until_(target_card, eval, true)\n                end\n            end\n        end\n    end\n}\n",
