        "card_dependencies": [],
        "perishable_compat": true,
        "customCode": {
          "fullCode": "--  Bubble\nSMODS.Joker {\n    key = 'bubble',\n    loc_txt = {\n        ['name'] = 'Bubble',\n        ['text'] = {\n            [1] = '{C:attention}When Boss Blind is defeated{}, creates a {C:attention}random Tag{}',\n            [2] = '{C:inactive}(Must have room){}'\n        }\n    },\n    pos = {\n        x = 2,\n        y = 0\n    },\n    cost = 5,\n    rarity = 2,\n    blueprint_compat = true,\n    eternal_compat = true,\n    perishable_compat = true,\n    unlocked = true,\n    discovered = true,\n    atlas = 'CustomJokers',\n    calculate = function(self, card, context)\n        if context.end_of_round and context.main_eval and G.GAME.blind.boss then\n            do\n                local selected_tag = pseudorandom_element(G.P_TAGS, pseudoseed('create_tag')).key; local tag = Tag(selected_tag); tag:set_ability(); add_tag(tag)\n                local target_card = card\n                if target_card then\n                target_card:juice_up(1, 1)\n                end\n                return {\n                    message = 'Created Tag!',\n                    colour = G.C.GREEN\n                }\n            end\n        end\n    end\n}\n",
          "lastGeneratedCode": "--  Bubble\nSMODS.Joker {\n    key = 'bubble',\n    config = {\n        extra = {\n            juice_scale0 = 1,\n            juice_rotation0 = 1\n        }\n    },\n    loc_txt = {\n        ['name'] = 'Bubble',\n        ['text'] = {\n            [1] = '{C:attention}When Boss Blind is defeated{}, creates a {C:attention}random Tag{}',\n            [2] = '{C:inactive}(Must have room){}'\n        }\n    },\n    pos = {\n        x = 0,\n        y = 0\n    },\n    cost = 5,\n    rarity = 2,\n    blueprint_compat = true,\n    eternal_compat = true,\n    perishable_compat = true,\n    unlocked = true,\n    discovered = true,\n    atlas = 'CustomJokers',\n    loc_vars = function(self, info_queue, card)\n        return {\n            vars = {\n                self.config.extra.juice_scale0,\n                self.config.extra.juice_rotation0\n            }\n        }\n    end,\n    calculate = function(self, card, context)\n        if context.end_of_round and context.main_eval and G.GAME.blind.boss then\n            do\n                local selected_tag = pseudorandom_element(G.P_TAGS, pseudoseed('create_tag')).key; local tag = Tag(selected_tag); tag:set_ability(); add_tag(tag)\n                local target_card = card\n                if target_card then\n                target_card:juice_up(card.ability.extra.juice_scale0, card.ability.extra.juice_rotation0)\n                end\n                return {\n                    message = 'Created Tag!',\n                    colour = G.C.GREEN\n                }\n            end\n        end\n    end\n}\n",
