        ],
        "perishable_compat": true,
        "customCode": {
          "fullCode": "--  Abbie\nSMODS.Joker {\n    key = 'abbie',\n    config = {\n        extra = {\n            abbieChips = 0\n        }\n    },\n    loc_txt = {\n        ['name'] = 'Abbie',\n        ['text'] = {\n            [1] = 'This Joker gains {C:blue}+15{} Chips when {C:attention}blind is skipped{}',\n            [2] = '{C:inactive}(Currently{} {C:blue}+#1#{} {C:inactive}Chips){}'\n        }\n    },\n    pos = {\n        x = 3,\n        y = 0\n    },\n    cost = 5,\n    rarity = 2,\n    blueprint_compat = true,\n    eternal_compat = true,\n    perishable_compat = true,\n    unlocked = true,\n    discovered = true,\n    atlas = 'CustomJokers',\n    loc_vars = function(self, info_queue, card)\n        return {\n            vars = {\n                card.ability.extra.abbieChips,\n            }\n        }\n    end,\n    calculate = function(self, card, context)\n        if context.skip_blind and context.main_eval then\n            do\n                local target_card = card\n                if target_card then\n                target_card:juice_up(1, 1)\n                end\n                return {\n                    func = function()\n                        card.ability.extra.abbieChips = (card.ability.extra.abbieChips) + 15\n                        return true\n                    end,\n                    colour = G.C.GREEN\n                }\n            end\n        end\n        if context.joker_main then\n            do\n                return {\n                    chips = card.ability.extra.abbieChips\n                }\n            end\n        end\n    end\n}\n",
          "lastGeneratedCode": "--  Abbie\nSMODS.Joker {\n    key = 'abbie',\n    config = {\n        extra = {\n            var_abbieChips0 = 15,\n            juice_scale0 = 1,\n            juice_rotation0 = 1,\n            abbieChips = 0\n        }\n    },\n    loc_txt = {\n        ['name'] = 'Abbie',\n        ['text'] = {\n            [1] = 'This Joker gains {C:blue}+15{} Chips when {C:attention}blind is skipped{}',\n            [2] = '{C:inactive}(Currently{} {C:blue}+#1#{} {C:inactive}Chips){}'\n        }\n    },\n    pos = {\n        x = 0,\n        y = 0\n    },\n    cost = 5,\n    rarity = 2,\n    blueprint_compat = true,\n    eternal_compat = true,\n    perishable_compat = true,\n    unlocked = true,\n    discovered = true,\n    atlas = 'CustomJokers',\n    loc_vars = function(self, info_queue, card)\n        return {\n            vars = {\n                self.config.extra.abbieChips,\n                self.config.extra.var_abbieChips0,\n                self.config.extra.juice_scale0,\n                self.config.extra.juice_rotation0\n            }\n        }\n    end,\n    calculate = function(self, card, context)\n        if context.skip_blind and context.main_eval then\n            do\n                local target_card = card\n                if target_card then\n                target_card:juice_up(card.ability.extra.juice_scale0, card.ability.extra.juice_rotation0)\n                end\n                return {\n                    func = function()\n                        card.ability.extra.abbieChips = (card.ability.extra.abbieChips) + card.ability.extra.var_abbieChips0\n                        return true\n                    end,\n                    colour = G.C.GREEN\n                }\n            end\n        end\n        if context.joker_main then\n            do\n                return {\n                    chips = card.ability.extra.abbieChips\n                }\n            end\n        end\n    end\n}\n",
