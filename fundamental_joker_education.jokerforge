          "fullCode": "-- Paper\nSMODS.Enhancement {\n    key = \"paper\",\n    name = \"Paper\",\n    pos = { x = 0, y = 0 },\n    config = {\n        extra = {\n            xchips = 1.5,\n            odds = 4\n        }\n    },\n    loc_txt = {\n        name = \"Paper\",\n        text = {\n            \"{C:white,X:chips}X#1#{} Chips\",\n            \"{C:green}#2# in #3#{} chance to {C:red}destroy{} self after scoring\"\n        }\n    },\n    atlas = \"CustomEnhancements\",\n    loc_vars = function(self, info_queue, card)\n        local numerator, denominator = SMODS.get_probability_vars(card, 1, card.ability.extra.odds, \"fpe_paper\")\n        return {\n            vars = {\n                card.ability.extra.xchips,\n                numerator,\n                denominator\n            }\n        }\n    end,\n    calculate = function(self, card, context)\n        if context.after and context.cardarea == G.play and SMODS.pseudorandom_probability(card, \"fpe_paper\", 1, card.ability.extra.odds) then\n            SMODS.destroy_cards(card)\n        end\n    end\n}",
          "lastGeneratedCode": "--  Paper\nSMODS.Enhancement {\n    key = 'paper',\n    pos = {\n        x = 0,\n        y = 0\n    },\n    config = {\n        extra = {\n            Xchips0 = 1.5,\n            numerator_0 = 1,\n            odds_0 = 4\n        }\n    },\n    loc_txt = {\n        ['name'] = 'Paper',\n        ['text'] = {\n            [1] = '{X:chips,C:white}1.5{} Chips',\n            [2] = '{C:green}1 in 4 chance{} to {C:red}destroy self{} after scoring'\n        }\n    },\n    atlas = 'CustomEnhancements',\n    any_suit = false,\n    replace_base_card = false,\n    no_rank = false,\n    no_suit = false,\n    always_scores = false,\n    unlocked = true,\n    discovered = true,\n    no_collection = false,\n    weight = 5,\n    loc_vars = function(self, info_queue, card)\n        local new_numerator0, new_denominator0 = SMODS.get_probability_vars(card, self.config.extra.numerator_0, self.config.extra.odds_0, 'm_fpe_paper')\n        return {\n            vars = {\n                self.config.extra.Xchips0,\n                new_numerator0,\n                new_denominator0\n            }\n        }\n    end,\n    calculate = function(self, card, context)\n        if context.main_scoring and context.cardarea == G.play then\n            card.should_destroy = false\n            do\n                card.should_destroy = true\n                if SMODS.pseudorandom_probability(card, 'group0', card.ability.extra.numerator_0, card.ability.extra.odds_0, 'm_fpe_paper', false) then\n                    context.other_card.glass_trigger = true\n                    context.other_card.should_destroy = true\n                    return {\n                        message = 'Destroyed!',\n                        colour = G.C.RED\n                    }\n                end\n                return {\n                    Xchips = card.ability.extra.Xchips0\n                }\n            end\n        end\n    end\n}\n",
