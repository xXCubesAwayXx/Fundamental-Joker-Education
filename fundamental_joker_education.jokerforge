          {
            "language": "en-us",
            "name": "Bubble",
            "description": "{C:attention}When Boss Blind is defeated{}, creates a {C:attention}random Tag{}[s]{C:inactive}(Must have room){}"
          }
        ],
        "appearFlags": [],
