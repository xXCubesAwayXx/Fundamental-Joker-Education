        "perishable_compat": true,
        "customCode": {
          "fullCode": "--  Claire\nSMODS.Joker {\n    key = 'claire',\n    config = {\n        extra = {\n            dollars0 = 1.5,\n        }\n    },\n    loc_txt = {\n        ['name'] = 'Claire',\n        ['text'] = {\n            [1] = 'At end of round, {C:money}multiplies money by 1.5{}',\n            [2] = '{C:inactive}Max{} {C:money}$10{}'\n        }\n    },\n    pos = {\n        x = 0,\n        y = 0\n    },\n    cost = 5,\n    rarity = 2,\n    blueprint_compat = true,\n    eternal_compat = true,\n    perishable_compat = true,\n    unlocked = true,\n    discovered = true,\n    atlas = 'CustomJokers',\n    loc_vars = function(self, info_queue, card)\n        return {\n            vars = {\n                self.config.extra.dollars0,\n                self.config.extra.juice_scale0,\n                self.config.extra.juice_rotation0\n            }\n        }\n    end,\n    calculate = function(self, card, context)\n        if context.end_of_round and context.game_over == false and context.main_eval then\n            do\n                local target_card = card\n                if target_card then\n                target_card:juice_up(1, 1)\n                end\n                return {\n                    dollars = (G.GAME.dollars * (card.ability.extra.dollars0)) - G.GAME.dollars,\n                    colour = G.C.MONEY\n                }\n            end\n        end\n    end\n}\n",
          "lastGeneratedCode": "--  Claire\nSMODS.Joker {\n    key = 'claire',\n    config = {\n        extra = {\n            dollars0 = 1.5,\n            juice_scale0 = 1,\n            juice_rotation0 = 1\n        }\n    },\n    loc_txt = {\n        ['name'] = 'Claire',\n        ['text'] = {\n            [1] = 'At end of round, {C:money}multiplies money by 1.5{}',\n            [2] = '{C:inactive}Max{} {C:money}$10{}'\n        }\n    },\n    pos = {\n        x = 0,\n        y = 0\n    },\n    cost = 5,\n    rarity = 2,\n    blueprint_compat = true,\n    eternal_compat = true,\n    perishable_compat = true,\n    unlocked = true,\n    discovered = true,\n    atlas = 'CustomJokers',\n    loc_vars = function(self, info_queue, card)\n        return {\n            vars = {\n                self.config.extra.dollars0,\n                self.config.extra.juice_scale0,\n                self.config.extra.juice_rotation0\n            }\n        }\n    end,\n    calculate = function(self, card, context)\n        if context.end_of_round and context.game_over == false and context.main_eval then\n            do\n                local target_card = card\n                if target_card then\n                target_card:juice_up(card.ability.extra.juice_scale0, card.ability.extra.juice_rotation0)\n                end\n                return {\n                    dollars = (G.GAME.dollars * (card.ability.extra.dollars0)) - G.GAME.dollars,\n                    colour = G.C.MONEY\n                }\n            end\n        end\n    end\n}\n",
