        "localizations": [
          {
            "language": "en-us",
            "name": "Mister Compass",
            "description": "This Joker gains {X:chips,C:white}0.5{} Chips when[s]{C:attention}scoring hand matches blind requirement on its own{}[s]{C:inactive}(Currently{} {X:chips,C:white}#1#{} {C:inactive}Chips){}"
