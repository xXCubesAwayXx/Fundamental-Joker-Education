          {
            "language": "en-us",
            "name": "Mister Demi",
            "description": "{C:red}+2 Discards{} when {C:money}obtained,{}[s] then {C:attention}scales that amount{} every {C:attention}Ante{}[s]{C:inactive}(Currently{} {C:red}+#1# Discards{}{C:inactive}){}"
          }
