          {
            "language": "en-us",
            "name": "Engel",
            "description": "If played hand {C:attention}triggers the Boss Blind effect{},[s]creates a random {C:attention}consumable{}[s]{C:inactive}(Must have room){}"
          }
        ],
        "appearFlags": [],
        "info_queues": [],
        "card_dependencies": [],
        "perishable_compat": true,
        "customCode": {
          "fullCode": "--  Engel\nSMODS.Joker {\n    key = 'engel',\n    config = {\n        extra = {\n            create_consumable_count0 = 1,\n        }\n    },\n    loc_txt = {\n        ['name'] = 'Engel',\n        ['text'] = {\n            [1] = 'If played hand {C:attention}triggers the Boss Blind effect{},',\n            [2] = 'creates a random {C:attention}consumable{}',\n            [3] = '{C:inactive}(Must have room){}'\n        }\n    },\n    pos = {\n        x = 1,\n        y = 0\n    },\n    cost = 5,\n    rarity = 2,\n    blueprint_compat = true,\n    eternal_compat = true,\n    perishable_compat = true,\n    unlocked = true,\n    discovered = true,\n    atlas = 'CustomJokers',\n    loc_vars = function(self, info_queue, card)\n        return {\n            vars = {\n                self.config.extra.create_consumable_count0,\n                self.config.extra.juice_scale0,\n                self.config.extra.juice_rotation0\n            }\n        }\n    end,\n    calculate = function(self, card, context)\n        if context.joker_main then\n            if G.GAME.blind.triggered then\n                if #G.consumeables.cards + (G.GAME.consumeable_buffer or 0) < G.consumeables.config.card_limit then SMODS.add_card({ area = G.consumeables, set = pseudorandom_element({'Tarot', 'Planet', 'Spectral'}, pseudoseed('create_consumable_set')), soulable = true }) end\n                local target_card = card\n                if target_card then\n                target_card:juice_up(1, 1)\n                end\n                return {\n                    message = localize('k_plus_consumable'),\n                    colour = G.C.GREEN\n                }\n            end\n        end\n    end\n}\n",
          "lastGeneratedCode": "--  Engel\nSMODS.Joker {\n    key = 'engel',\n    config = {\n        extra = {\n            create_consumable_count0 = 1,\n            juice_scale0 = 1,\n            juice_rotation0 = 1\n        }\n    },\n    loc_txt = {\n        ['name'] = 'Engel',\n        ['text'] = {\n            [1] = 'If played hand {C:attention}triggers the Boss Blind effect{},',\n            [2] = 'creates a random {C:attention}consumable{}',\n            [3] = '{C:inactive}(Must have room){}'\n        }\n    },\n    pos = {\n        x = 0,\n        y = 0\n    },\n    cost = 5,\n    rarity = 2,\n    blueprint_compat = true,\n    eternal_compat = true,\n    perishable_compat = true,\n    unlocked = true,\n    discovered = true,\n    atlas = 'CustomJokers',\n    loc_vars = function(self, info_queue, card)\n        return {\n            vars = {\n                self.config.extra.create_consumable_count0,\n                self.config.extra.juice_scale0,\n                self.config.extra.juice_rotation0\n            }\n        }\n    end,\n    calculate = function(self, card, context)\n        if context.joker_main then\n            if G.GAME.blind.triggered then\n                if #G.consumeables.cards + (G.GAME.consumeable_buffer or 0) < G.consumeables.config.card_limit then SMODS.add_card({ area = G.consumeables, set = pseudorandom_element({'Tarot', 'Planet', 'Spectral'}, pseudoseed('create_consumable_set')), soulable = true }) end\n                local target_card = card\n                if target_card then\n                target_card:juice_up(card.ability.extra.juice_scale0, card.ability.extra.juice_rotation0)\n                end\n                return {\n                    message = localize('k_plus_consumable'),\n                    colour = G.C.GREEN\n                }\n            end\n        end\n    end\n}\n",
