        "localizations": [
          {
            "language": "en-us",
            "name": "Alice",
            "description": "{C:green}1 in 2{} chance to apply {C:dark_edition}Negative{} to {C:red}discarded{} {C:attention}face cards{}[s]Scales {X:mult,C:white}0.5{} Mult when {C:attention}ability is activated{}[s]{C:inactive}(Currently {}{X:mult,C:white}#1#{} {C:inactive} Mult){}"
